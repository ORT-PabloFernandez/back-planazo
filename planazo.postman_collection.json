{
  "info": {
    "name": "Planazo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"email\": \"juan@planazo.com\",\n  \"password\": \"Test1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token guardado automáticamente.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@planazo.com\",\n  \"password\": \"Test1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        },
        {
          "name": "Obtener todos los usuarios",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "Planes",
      "item": [
        {
          "name": "Sugerir planes (completo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidadChicos\": 3,\n  \"cantidadChicas\": 2,\n  \"preferencias\": [\"música en vivo\", \"cerveza artesanal\"],\n  \"restriccionesComida\": [\"vegetariano\"],\n  \"presupuesto\": \"medio\",\n  \"zona\": \"Palermo\",\n  \"ubicacion\": \"Av. Santa Fe y Callao, Buenos Aires\",\n  \"disponibilidad\": \"noche del sábado\",\n  \"edadPromedio\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "suggest"]
            }
          }
        },
        {
          "name": "Sugerir planes (mínimo)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidadPersonas\": 4,\n  \"presupuesto\": \"bajo\",\n  \"disponibilidad\": \"domingo a la tarde\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "suggest"]
            }
          }
        },
        {
          "name": "Sugerir planes (con ubicacion)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidadChicos\": 2,\n  \"cantidadChicas\": 2,\n  \"preferencias\": [\"aire libre\", \"deporte\"],\n  \"restriccionesComida\": [],\n  \"presupuesto\": \"bajo\",\n  \"ubicacion\": \"San Telmo, Buenos Aires\",\n  \"disponibilidad\": \"sábado a la mañana\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/plans/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "suggest"]
            }
          }
        },
        {
          "name": "Historial de planes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/plans/historial",
              "host": ["{{baseUrl}}"],
              "path": ["api", "plans", "historial"]
            }
          }
        }
      ]
    }
  ]
}
